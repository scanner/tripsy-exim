# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtualenv / uv
.venv/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Credentials and local configuration.  Nothing here should ever be
# committed: the token from POST /auth is held in memory for the run, and
# the 1Password item URL lives in the environment.
.env

# Local trip archives.  Real trip data never belongs in the repository.
archive/
*.ics
!tests/fixtures/**/*.ics
